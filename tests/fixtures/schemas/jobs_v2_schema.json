{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "last_modified", "jobs"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 2
    },
    "last_modified": {
      "type": "string",
      "format": "date-time"
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["job_id", "company", "title", "date_applied", "status", "stage", "source"],
        "properties": {
          "job_id": {
            "type": "string",
            "pattern": "^job_[a-f0-9]{12}$"
          },
          "company": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "date_applied": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "type": "string",
            "enum": ["Applied", "Interviewing", "Offer", "Rejected", "Ghosted", "Withdrawn", "Hired", "Declined", "Under Consideration"]
          },
          "stage": {
            "type": "string",
            "enum": ["applied", "screening", "interview", "offer", "employed", "closed"]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string"
          },
          "job_type": {
            "type": "string"
          },
          "salary_range": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "country": {
            "type": "string"
          }
        }
      }
    }
  }
}