{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "job_id", "timestamp", "author", "type", "summary"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^fu_"
          },
          "job_id": {
            "type": "string",
            "pattern": "^job_[a-f0-9]{12}$"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["note", "status_change", "interview", "offer", "rejection"]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "string"
          },
          "next_action": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["what", "when", "done"],
                "properties": {
                  "what": {"type": "string"},
                  "when": {"type": "string"},
                  "done": {"type": "boolean"}
                }
              }
            ]
          },
          "tags": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}